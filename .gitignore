# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Node / tooling (if any scripts are added later)
node_modules/
*.log

# Temporary LLM scratch files (never committed)
scratch.*
.tmp/
.planning/phases/*
.planning/config.json

# The .planning folder is part of the implementation history; ignore it for templates.

# LLM Agent configurations (local state)
.gemini/*
!.gemini/GEMINI.md
.claude/
.agent/
dist/

# Personal rule files (if any)
PROJECT_RULES.md
SUPERPOWER-STYLE.md



# --- PROTECTED REPO STRUCTURE ---

# 📥 RAW DIRECTORY: Ignore all content except the structural placeholder
raw/*
!raw/.gitkeep
!raw/archive/
raw/archive/*
!raw/archive/.gitkeep

# 🧠 WIKI DIRECTORY: Track all markdown knowledge files in wiki/
wiki/*
!wiki/.gitkeep
!wiki/*.md
!wiki/*.json

# Allow subdirectories so git can inspect their contents
!wiki/comparisons/
!wiki/concepts/
!wiki/entities/
!wiki/qa/
!wiki/sources/
!wiki/archive/
!wiki/meta/

# Track all markdown files and structural placeholders in silos
wiki/comparisons/*
!wiki/comparisons/.gitkeep
!wiki/comparisons/*.md

wiki/concepts/*
!wiki/concepts/.gitkeep
!wiki/concepts/*.md

wiki/entities/*
!wiki/entities/.gitkeep
!wiki/entities/*.md

wiki/qa/*
!wiki/qa/.gitkeep
!wiki/qa/*.md

wiki/sources/*
!wiki/sources/.gitkeep
!wiki/sources/*.md

wiki/archive/*
!wiki/archive/*/
!wiki/archive/.gitkeep
!wiki/archive/*.md
wiki/archive/*/*
!wiki/archive/*/.gitkeep
!wiki/archive/*/*.md

wiki/meta/*
!wiki/meta/.gitkeep
!wiki/meta/*.md
!wiki/meta/*.json
